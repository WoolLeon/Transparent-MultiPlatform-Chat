<Window x:Class="MultiChatOverlay.App.Settings.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="400" Height="160"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B1B" Foreground="#F2F2F2"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#202020"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#141414"/>
        <SolidColorBrush x:Key="LineBrush" Color="#5A5A5A"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="Enter value:" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,0,0,12"
                 Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                 BorderThickness="1" Padding="8,6" KeyDown="InputTextBox_KeyDown"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="70" Margin="0,0,8,0" Click="OK_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="70" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>