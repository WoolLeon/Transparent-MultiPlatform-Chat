<Window x:Class="MultiChatOverlay.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Settings" Width="790" Height="580" MinWidth="650" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Loaded="SettingsWindow_Loaded" Closed="SettingsWindow_Closed"
        Background="#1B1B1B" Foreground="#F2F2F2">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#202020"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#141414"/>
        <SolidColorBrush x:Key="LineBrush" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B8B8B8"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#292929"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#424242"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F4F4F4"/>
            <Setter Property="Background" Value="#393939"/>
            <Setter Property="BorderBrush" Value="#676767"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A4A4A"/>
                    <Setter Property="BorderBrush" Value="#8A8A8A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#454545"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#272727"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#303030"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BEBEBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="138"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#111111" BorderBrush="#3D3D3D" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MULTI CHAT" FontSize="11" FontWeight="Bold"
                           Foreground="#AFAFAF" Margin="13,14,8,10"/>
                <ListBox x:Name="SettingsNavigation" SelectionChanged="SettingsNavigation_SelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Profiles"/>
                    <ListBoxItem Content="Connections"/>
                    <ListBoxItem Content="Appearance"/>
                    <ListBoxItem Content="Emotes"/>
                    <ListBoxItem Content="Filtering"/>
                    <ListBoxItem Content="Export"/>
                    <ListBoxItem Content="Events"/>
                    <ListBoxItem Content="Hotkeys"/>
                    <ListBoxItem Content="Streamer.bot"/>
                    <ListBoxItem Content="Advanced"/>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="#1B1B1B" Padding="16,14,16,10">
            <TabControl x:Name="SettingsTabs" SelectedIndex="0">
                <TabItem Header="General">
                    <StackPanel>
                        <TextBlock Text="General" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Position and opacity are saved automatically. Ctrl+Shift+O hides or shows the overlay."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Overlay opacity" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.25" Maximum="1" TickFrequency="0.05"/>
                        <CheckBox x:Name="DedupeCheckBox" Content="Ignore repeated platform message IDs" Margin="0,14,0,0"/>

                        <GroupBox Header="Auto-hide on Inactivity" Margin="0,14,0,0">
                            <StackPanel>
                                <CheckBox x:Name="EnableAutoHideCheckBox" Content="Fade overlay when no new messages arrive" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Inactivity timeout (seconds)" VerticalAlignment="Center" Width="180"/>
                                    <TextBox x:Name="AutoHideSecondsBox" Width="60" Text="30" ToolTip="Seconds without new messages before fading (5-3600)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Faded opacity" VerticalAlignment="Center" Width="180"/>
                                    <Slider x:Name="AutoHideOpacitySlider" Minimum="0.05" Maximum="0.5" TickFrequency="0.05" Width="200" Value="0.1"/>
                                </StackPanel>
                                <TextBlock Text="When enabled, the overlay will fade to the specified opacity after the timeout with no new messages. Any new message will restore full opacity."
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Profiles">
                    <StackPanel>
                        <TextBlock Text="Profiles" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <TextBlock Text="Manage multiple streamer configurations. Each profile stores its own connections, appearance, and settings."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Active Profile:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ProfileSelector" Width="250" SelectionChanged="ProfileSelector_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="NewProfileButton" Content="New Profile..." Padding="10,4" Click="NewProfile_Click" Margin="0,0,8,0"/>
                            <Button x:Name="RenameProfileButton" Content="Rename" Padding="10,4" Click="RenameProfile_Click" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteProfileButton" Content="Delete" Padding="10,4" Click="DeleteProfile_Click" Margin="0,0,8,0"
                                    Foreground="#FF6B6B" BorderBrush="#8A3A3A" Background="#3A2020"/>
                            <Button x:Name="DuplicateProfileButton" Content="Duplicate" Padding="10,4" Click="DuplicateProfile_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ProfileInfoText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Connections">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Connections" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Sign in opens the provider’s consent page. OAuth Client IDs are configured in .env. Client secrets are encrypted locally with Windows DPAPI. Twitch sign-in grants chat and channel point redemption access; use the broadcaster's account for Twitch events. The app never asks for or stores your platform password."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                            <GroupBox Header="Twitch" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="TwitchEnabled" Content="Show Twitch"/>
                                    <CheckBox x:Name="UseTwitchAccountAsChannelCheckBox"
                                              Content="Automatically use my signed-in Twitch account as the channel"
                                              Margin="0,6,0,0"
                                              Checked="UseTwitchAccountAsChannel_Changed"
                                              Unchecked="UseTwitchAccountAsChannel_Changed"/>
                                    <TextBlock Text="Channel login" Margin="0,8,0,3"/>
                                    <TextBox x:Name="TwitchChannelBox"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="21" ClipToBounds="True"
                                                Background="#333333" BorderBrush="#5A5A5A" BorderThickness="1">
                                            <Image x:Name="TwitchAvatarImage" Stretch="UniformToFill"
                                                   ToolTip="Twitch profile avatar"/>
                                        </Border>
                                        <TextBlock x:Name="TwitchAccountStatus" Grid.Column="1" Text="Not signed in"
                                                   VerticalAlignment="Center" Margin="10,0,8,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="TwitchSignInButton" Content="Sign in to Twitch" Padding="10,4"
                                                    Click="TwitchSignIn_Click"/>
                                            <Button x:Name="TwitchLogOffButton" Content="Log off" Padding="10,4"
                                                    Margin="6,0,0,0" Visibility="Collapsed"
                                                    Click="TwitchLogOff_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="YouTube" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="YouTubeEnabled" Content="Show YouTube"/>
                                    <TextBlock Text="Live video URL, video ID, or channel @handle" Margin="0,8,0,3"/>
                                    <TextBox x:Name="YouTubeTargetBox"/>
                                    <TextBlock Text="No Google sign-in or API key needed. A channel handle connects only when a live chat is available; a video URL or ID is more reliable. Use the video ID, not the old API liveChatId. Restricted chats may not be accessible."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Kick (OAuth; chat events still arrive via Streamer.bot)" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="KickEnabled" Content="Show Kick"/>
                                    <TextBlock Text="Your Kick app client secret (encrypted locally with Windows DPAPI)" Margin="0,8,0,3"/>
                                    <PasswordBox x:Name="KickClientSecretBox"/>
                                    <CheckBox x:Name="ClearKickSecretCheckBox" Content="Clear saved Kick app secret" Margin="0,4,0,0"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="Sign in to Kick" Padding="10,4" Click="KickSignIn_Click" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="KickAccountStatus" Text="Not signed in" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <TextBlock Text="Register http://localhost:43821/callback/ as the exact redirect URI in your Kick application."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Facebook">
                                <StackPanel>
                                    <CheckBox x:Name="FacebookEnabled" Content="Show Facebook"/>
                                    <TextBlock Text="Live video ID" Margin="0,8,0,3"/>
                                    <TextBox x:Name="FacebookLiveVideoIdBox"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="Sign in to Facebook" Padding="10,4" Click="FacebookSignIn_Click" DockPanel.Dock="Left"/>
                                        <TextBlock x:Name="FacebookAccountStatus" Text="Not signed in" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Poll interval (seconds)" VerticalAlignment="Center" Width="160"/>
                                        <TextBox x:Name="FacebookPollIntervalBox" Width="60" Text="5" ToolTip="How often to poll Facebook Graph API for new comments (1-300)"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Max poll interval (seconds)" VerticalAlignment="Center" Width="160"/>
                                        <TextBox x:Name="FacebookMaxPollIntervalBox" Width="60" Text="60" ToolTip="Maximum backoff interval on rate limits (5-3600)"/>
                                    </StackPanel>
                                    <TextBlock Text="Configure Facebook Login and the Pages permissions required to read live-video comments in your Meta app. Poll interval controls how often the app checks for new comments; increase to reduce API calls."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <TextBlock Text="CSS theme" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,5,0,8">
                                <Button Content="Add..." DockPanel.Dock="Right" Click="AddCssTheme_Click" Margin="8,0,0,0"/>
                                <ComboBox x:Name="ThemePicker" SelectedIndex="0">
                                    <ComboBoxItem Content="Default"/>
                                    <ComboBoxItem Content="Compact"/>
                                    <ComboBoxItem Content="High contrast"/>
                                    <ComboBoxItem Content="Sleek Dark"/>
                                </ComboBox>
                            </DockPanel>
                            <Button Content="Apply selected theme" HorizontalAlignment="Left" Margin="0,0,0,14"
                                    Click="ApplyTheme_Click"/>
                            <TextBlock Text="CSS file (optional)" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,5,0,12">
                                <Button Content="Browse..." DockPanel.Dock="Right" Click="BrowseCss_Click" Margin="8,0,0,0"/>
                                <TextBox x:Name="CssPathBox"/>
                            </DockPanel>
                            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Height="150" Background="#141414" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" Margin="0,0,0,12">
                                <wv2:WebView2 x:Name="CssPreviewView"/>
                            </Border>
                            <TextBlock x:Name="CssPreviewStatus" Text="Preview shows sample chat messages and an event."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <TextBlock Text="Inline CSS override" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="CustomCssBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     Height="160" FontFamily="Consolas" TextWrapping="NoWrap"
                                     TextChanged="CustomCssBox_TextChanged"/>
                            <Button Content="Reset CSS" HorizontalAlignment="Left" Margin="0,10,0,8"
                                    Click="ResetCss_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Emotes">
                    <StackPanel>
                        <TextBlock Text="Emotes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Twitch native emotes are always enabled. Third-party sets load global and channel emotes when Twitch is connected."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="SevenTvEmotesEnabled" Content="Enable 7TV emotes" Margin="0,0,0,8"/>
                        <CheckBox x:Name="BetterTtvEmotesEnabled" Content="Enable BetterTTV emotes" Margin="0,0,0,8"/>
                        <CheckBox x:Name="FrankerFaceZEmotesEnabled" Content="Enable FrankerFaceZ emotes"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Filtering">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Message Filtering" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock Text="Filter chat messages by regex patterns or user names. All patterns use .NET regex syntax (case-insensitive). Enable filtering to apply these rules."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                            <CheckBox x:Name="EnableMessageFilteringCheckBox" Content="Enable message filtering" Margin="0,0,0,16"/>

                            <GroupBox Header="Allow Patterns (messages matching ANY of these are shown)" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="One pattern per line. If allow patterns are set, ONLY messages matching at least one pattern will be shown." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBox x:Name="AllowPatternsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Height="100" FontFamily="Consolas" TextWrapping="NoWrap"
                                             Margin="0,0,0,4"/>
                                    <TextBlock x:Name="AllowPatternsHint" Text="Example: ^!cmd\s|^\?help$|^!so\s" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Block Patterns (messages matching ANY of these are hidden)" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="One pattern per line. Messages matching these patterns will be hidden. Applied after allow patterns." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBox x:Name="BlockPatternsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Height="100" FontFamily="Consolas" TextWrapping="NoWrap"
                                             Margin="0,0,0,4"/>
                                    <TextBlock x:Name="BlockPatternsHint" Text="Example: http[s]?://|www\.|discord\.gg/|@everyone|@here" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Ignored Users (messages from these users are hidden)" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="One username per line (case-insensitive). Applied regardless of allow/block patterns." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <TextBox x:Name="IgnoredUsersBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Height="80" FontFamily="Consolas" TextWrapping="NoWrap"
                                             Margin="0,0,0,4"/>
                                    <TextBlock x:Name="IgnoredUsersHint" Text="Example: Nightbot|StreamElements|Moobot|Streamelements" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Export">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="OBS Browser Source Export" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                            <TextBlock Text="Export a standalone HTML file that can be used as an OBS Browser Source. The exported file includes all CSS, JavaScript, and current theme settings embedded."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                            <GroupBox Header="Export Settings" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Theme to embed:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ExportThemePicker" Width="250" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Current Theme" IsSelected="True"/>
                                        <ComboBoxItem Content="Default"/>
                                        <ComboBoxItem Content="Compact"/>
                                        <ComboBoxItem Content="High contrast"/>
                                        <ComboBoxItem Content="Sleek Dark"/>
                                    </ComboBox>

                                    <CheckBox x:Name="ExportIncludeCustomCssCheckBox" Content="Include inline CSS override" IsChecked="True" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ExportIncludeSampleMessagesCheckBox" Content="Include sample messages for preview" IsChecked="True" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ExportAutoScrollCheckBox" Content="Auto-scroll to new messages" IsChecked="True" Margin="0,0,0,12"/>

                                    <TextBlock Text="Background:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ExportBackgroundPicker" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Transparent" IsSelected="True"/>
                                        <ComboBoxItem Content="Semi-transparent dark (#1B1B1BCC)"/>
                                        <ComboBoxItem Content="Opaque dark (#1B1B1B)"/>
                                        <ComboBoxItem Content="Custom color..."/>
                                    </ComboBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="ExportPreviewButton" Content="Preview in Browser" Padding="12,6" Click="ExportPreview_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="ExportSaveButton" Content="Save HTML File..." Padding="12,6" Click="ExportSave_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="ExportStatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="About OBS Browser Source" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="To use the exported HTML in OBS:" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="1. Add a 'Browser' source in OBS" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="2. Check 'Local file' and select the exported HTML file" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="3. Set Width/Height to match your overlay size" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="4. Enable 'Control audio via OBS' if you need audio" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="5. The browser source will display the chat overlay - messages won't update live (static export). For live updates, use the WPF overlay window directly." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Events">
                    <StackPanel>
                        <TextBlock Text="Events" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Twitch IRC alerts: subscriptions, resubs, gift subs, raids, and cheers. Channel point redemptions and Twitch follows require Streamer.bot connected to the broadcaster account. YouTube alerts: Super Chats, Super Stickers, and memberships from the live chat provider. Kick alerts and cross-platform follows, raids, and tips can be relayed by Streamer.bot. Facebook comments do not provide follow/subscription alerts."
                                   Foreground="{StaticResource MutedBrush}" LineHeight="22"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Hotkeys">
                    <StackPanel>
                        <TextBlock Text="Hotkeys" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Text="Ctrl+Shift+L   Lock / unlock (locked mode passes clicks through)" Margin="0,0,0,10"/>
                        <TextBlock Text="Ctrl+Shift+O   Show / hide" Margin="0,0,0,10"/>
                        <TextBlock Text="Ctrl+Shift+C   Clear chat" Margin="0,0,0,10"/>
                        <TextBlock Text="Ctrl+Shift+Up / Down   Increase / decrease opacity"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Streamer.bot">
                    <StackPanel>
                        <TextBlock Text="Streamer.bot" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <CheckBox x:Name="StreamerBotEnabled" Content="Connect to Streamer.bot"/>
                        <TextBlock Text="WebSocket URL" FontWeight="SemiBold" Margin="0,12,0,5"/>
                        <TextBox x:Name="StreamerBotUrlBox" Width="300" HorizontalAlignment="Left"/>
                        <TextBlock Text="Duplicate prevention" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <CheckBox x:Name="StreamerBotMessageDedupe"
                                  Content="Suppress relayed chat already received from the native platform"
                                  Margin="0,0,0,7"/>
                        <CheckBox x:Name="StreamerBotEventDedupe"
                                  Content="Suppress relayed alerts already received from the native platform"
                                  Margin="0,0,0,7"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" LineHeight="22"
                                   Text="Streamer.bot is optional for native Twitch channel point events, which use your Twitch sign-in. This connector adds Streamer.bot-relayed Twitch, YouTube and Kick events and supports SendMessage and DoAction."/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" LineHeight="22"
                                   Text="Relay matching compares platform, user and message or alert details within a short window. The first copy is kept. Repeated platform IDs are controlled separately under General."/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Advanced">
                    <StackPanel>
                        <TextBlock Text="Advanced" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}"
                                   Text="Settings are stored in %AppData%\MultiChatOverlay\settings.json. OAuth secrets use Windows DPAPI for the current user."/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#202020" BorderBrush="#555555"
                BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CSS edits preview live" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True"/>
                    <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
