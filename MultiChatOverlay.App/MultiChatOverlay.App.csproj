<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Native AOT / Trimming Configuration -->
    <PublishAot>true</PublishAot>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>true</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <WindowsFormsTrimmerError>false</WindowsFormsTrimmerError>

    <!-- Single-file publish options -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishAot>false</PublishAot>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiChatOverlay.Core\MultiChatOverlay.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3240" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Trim exclusions for WebView2 and WPF -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Wpf" />
    <TrimmerRootAssembly Include="System.Windows" />
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Configuration.ConfigurationManager" />
    <TrimmerRootAssembly Include="System.Drawing" />
    <TrimmerRootAssembly Include="System.Drawing.Common" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
  </ItemGroup>

  <!-- Trimmer root descriptors for reflection-used types -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="MultiChatOverlay.App.Logging.Log" />
    <TrimmerRootDescriptor Include="MultiChatOverlay.App.Settings.OAuthLoginService" />
    <TrimmerRootDescriptor Include="MultiChatOverlay.Core.Services.MessageDeduplicator" />
    <TrimmerRootDescriptor Include="MultiChatOverlay.Core.Services.ChatEventDeduplicator" />
    <TrimmerRootDescriptor Include="MultiChatOverlay.Core.Services.EmoteMessageMatcher" />
    <TrimmerRootDescriptor Include="MultiChatOverlay.App.Emotes.ThirdPartyEmoteCatalog" />
  </ItemGroup>

</Project>